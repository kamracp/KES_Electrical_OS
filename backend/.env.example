# KES Electrical OS backend — environment template.
# Copy to backend/.env and fill the values locally; .env is git-ignored and never committed.
# Every key carries the KES_ prefix: the settings class uses env_prefix="KES_" and silently
# ignores unprefixed keys.

KES_APP_NAME="KES Electrical OS API"
KES_APP_VERSION=0.1.0
KES_ENVIRONMENT=development          # development | staging | production
KES_DEBUG=false
KES_LOG_LEVEL=INFO

# PostgreSQL (psycopg v3 driver, as declared in pyproject). Production: dedicated database and role for this product.
KES_DATABASE_URL=postgresql+psycopg://keos:CHANGE_ME@127.0.0.1:5432/kes_electrical_os
KES_DATABASE_ECHO=false

# JSON lists. Wildcard "*" is rejected by the settings validator.
# Development (Vite dev server):
KES_BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
KES_ALLOWED_HOSTS=["localhost","127.0.0.1"]
# Production:
# KES_BACKEND_CORS_ORIGINS=["https://electrical.kamraengineeringsolution.com"]
# KES_ALLOWED_HOSTS=["electrical.kamraengineeringsolution.com","127.0.0.1"]

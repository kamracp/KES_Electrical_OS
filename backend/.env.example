# KES Electrical OS backend — environment template.
# Copy to backend/.env and fill the values locally; .env is git-ignored and never committed.

APP_NAME="KES Electrical OS API"
APP_VERSION=0.1.0
ENVIRONMENT=development          # development | staging | production
DEBUG=false
LOG_LEVEL=INFO

# PostgreSQL (asyncpg driver). Production: dedicated database and role for this product.
DATABASE_URL=postgresql+asyncpg://keos:CHANGE_ME@127.0.0.1:5432/kes_electrical_os
DATABASE_ECHO=false

# JSON lists. Wildcard "*" is rejected by the settings validator.
# Development (Vite dev server):
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]
# Production:
# BACKEND_CORS_ORIGINS=["https://electrical.kamraengineeringsolution.com"]
# ALLOWED_HOSTS=["electrical.kamraengineeringsolution.com","127.0.0.1"]
